        "$ref": "#/$defs/DatasetRevisionFile"
      },
      "title": "Files",
      "type": "array"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "revision_id": {
      "title": "Revision Id",
      "type": "string"
    },
    "schema_version": {
      "const": "V0.2",
      "default": "V0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "validation_outcome": {
      "$ref": "#/$defs/ValidationLevel"
    }
  },
  "required": [
    "revision_id",
    "dataset_id",
    "revision",
    "source_sha256",
    "validation_outcome",
    "calibration_eligible",
    "files"
