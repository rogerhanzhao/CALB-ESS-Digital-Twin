          "type": "integer"
        },
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "file_name",
        "content_type",
        "byte_count",
        "sha256"
      ],
      "title": "DatasetRevisionFile",
      "type": "object"
    },
    "ValidationLevel": {
      "enum": [
        "pass",
        "warning",
        "reject"
      ],
      "title": "ValidationLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "calibration_eligible": {
      "title": "Calibration Eligible",
      "type": "boolean"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "files": {
