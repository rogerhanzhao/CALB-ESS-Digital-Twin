{
  "$defs": {
    "CalibrationValidityEnvelope": {
      "additionalProperties": false,
      "properties": {
        "approved_extrapolation_limits": {
          "$ref": "#/$defs/ExtrapolationLimits"
        },
        "charge_c_rate_max": {
          "title": "Charge C Rate Max",
          "type": "number"
        },
        "charge_c_rate_min": {
          "title": "Charge C Rate Min",
          "type": "number"
        },
        "depth_of_discharge_max": {
          "title": "Depth Of Discharge Max",
          "type": "number"
        },
        "depth_of_discharge_min": {
          "title": "Depth Of Discharge Min",
          "type": "number"
        },
        "discharge_c_rate_max": {
          "title": "Discharge C Rate Max",
          "type": "number"
        },
        "discharge_c_rate_min": {
          "title": "Discharge C Rate Min",
          "type": "number"
        },
        "mean_soc_max": {
          "title": "Mean Soc Max",
          "type": "number"
        },
        "mean_soc_min": {
          "title": "Mean Soc Min",
          "type": "number"
        },
        "product_revision": {
          "title": "Product Revision",
          "type": "string"
        },
        "temperature_max_c": {
          "title": "Temperature Max C",
          "type": "number"
        },
        "temperature_min_c": {
          "title": "Temperature Min C",
          "type": "number"
        },
        "training_maximum_absolute_throughput_ah": {
          "title": "Training Maximum Absolute Throughput Ah",
          "type": "number"
        },
        "training_maximum_cycle_count": {
          "title": "Training Maximum Cycle Count",
          "type": "integer"
        },
        "training_maximum_elapsed_days": {
          "title": "Training Maximum Elapsed Days",
          "type": "number"
        },
        "training_maximum_equivalent_full_cycles": {
          "title": "Training Maximum Equivalent Full Cycles",
          "type": "number"
        }
      },
      "required": [
        "product_revision",
        "temperature_min_c",
        "temperature_max_c",
        "depth_of_discharge_min",
        "depth_of_discharge_max",
        "mean_soc_min",
        "mean_soc_max",
        "charge_c_rate_min",
        "charge_c_rate_max",
        "discharge_c_rate_min",
        "discharge_c_rate_max",
        "training_maximum_elapsed_days",
        "training_maximum_cycle_count",
        "training_maximum_equivalent_full_cycles",
        "training_maximum_absolute_throughput_ah",
        "approved_extrapolation_limits"
      ],
      "title": "CalibrationValidityEnvelope",
      "type": "object"
    },
    "ExtrapolationLimits": {
      "additionalProperties": false,
      "description": "Method-approved horizon; separate from the observed training exposure.",
      "properties": {
        "maximum_absolute_throughput_ah": {
          "minimum": 0,
          "title": "Maximum Absolute Throughput Ah",
          "type": "number"
        },
        "maximum_cycle_count": {
          "minimum": 0,
          "title": "Maximum Cycle Count",
          "type": "integer"
        },
        "maximum_elapsed_days": {
          "minimum": 0,
          "title": "Maximum Elapsed Days",
          "type": "number"
        },
        "maximum_equivalent_full_cycles": {
          "minimum": 0,
          "title": "Maximum Equivalent Full Cycles",
          "type": "number"
        }
      },
      "required": [
        "maximum_elapsed_days",
        "maximum_cycle_count",
        "maximum_equivalent_full_cycles",
        "maximum_absolute_throughput_ah"
      ],
      "title": "ExtrapolationLimits",
      "type": "object"
    },
    "FitMetrics": {
      "additionalProperties": false,
      "properties": {
        "jacobian_condition_number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jacobian Condition Number"
        },
        "jacobian_rank": {
          "minimum": 0,
          "title": "Jacobian Rank",
          "type": "integer"
        },
        "solver_cost": {
          "minimum": 0,
          "title": "Solver Cost",
          "type": "number"
        },
        "solver_evaluations": {
          "minimum": 0,
          "title": "Solver Evaluations",
          "type": "integer"
        },
        "training_rmse_fraction": {
          "minimum": 0,
          "title": "Training Rmse Fraction",
          "type": "number"
        },
        "validation_max_absolute_error_fraction": {
          "minimum": 0,
          "title": "Validation Max Absolute Error Fraction",
          "type": "number"
        },
        "validation_rmse_fraction": {
          "minimum": 0,
          "title": "Validation Rmse Fraction",
          "type": "number"
        }
      },
      "required": [
        "training_rmse_fraction",
        "validation_rmse_fraction",
        "validation_max_absolute_error_fraction",
        "jacobian_rank",
        "solver_cost",
        "solver_evaluations"
      ],
      "title": "FitMetrics",
      "type": "object"
    },
    "ObservationFit": {
      "additionalProperties": false,
      "properties": {
        "measured_capacity_fraction": {
          "title": "Measured Capacity Fraction",
          "type": "number"
        },
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "predicted_capacity_fraction": {
          "title": "Predicted Capacity Fraction",
          "type": "number"
        },
        "residual_fraction": {
          "title": "Residual Fraction",
          "type": "number"
        },
        "split": {
          "$ref": "#/$defs/SplitRole"
        }
      },
      "required": [
        "observation_id",
        "split",
        "measured_capacity_fraction",
        "predicted_capacity_fraction",
        "residual_fraction"
      ],
      "title": "ObservationFit",
      "type": "object"
    },
    "SemiEmpiricalParameters": {
      "additionalProperties": false,
      "properties": {
        "calendar_coefficient_per_sqrt_day": {
          "minimum": 0,
          "title": "Calendar Coefficient Per Sqrt Day",
          "type": "number"
        },
        "throughput_coefficient_per_ah_power": {
          "minimum": 0,
          "title": "Throughput Coefficient Per Ah Power",
          "type": "number"
        },
        "throughput_exponent": {
          "exclusiveMinimum": 0,
          "title": "Throughput Exponent",
          "type": "number"
        }
      },
      "required": [
        "calendar_coefficient_per_sqrt_day",
        "throughput_coefficient_per_ah_power",
        "throughput_exponent"
      ],
      "title": "SemiEmpiricalParameters",
      "type": "object"
    },
    "SplitRole": {
      "enum": [
        "train",
        "validation"
      ],
      "title": "SplitRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Draft calibration artifact; ``approval_eligible`` is not approval.",
  "properties": {
    "approval_eligible": {
      "title": "Approval Eligible",
      "type": "boolean"
    },
    "calibration_id": {
      "title": "Calibration Id",
      "type": "string"
    },
    "code_revision": {
      "title": "Code Revision",
      "type": "string"
    },
    "dataset_revision_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Dataset Revision Ids",
      "type": "array"
    },
    "fit_converged": {
      "title": "Fit Converged",
      "type": "boolean"
    },
    "identifiable": {
      "title": "Identifiable",
      "type": "boolean"
    },
    "meets_validation_limit": {
      "title": "Meets Validation Limit",
      "type": "boolean"
    },
    "metrics": {
      "$ref": "#/$defs/FitMetrics"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "observation_fits": {
      "items": {
        "$ref": "#/$defs/ObservationFit"
      },
      "title": "Observation Fits",
      "type": "array"
    },
    "parameters": {
      "$ref": "#/$defs/SemiEmpiricalParameters"
    },
    "parameters_at_bounds": {
      "title": "Parameters At Bounds",
      "type": "boolean"
    },
    "product_revision": {
      "title": "Product Revision",
      "type": "string"
    },
    "schema_version": {
      "const": "V0.2",
      "default": "V0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "validity_envelope": {
      "$ref": "#/$defs/CalibrationValidityEnvelope"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "calibration_id",
    "model_version",
    "code_revision",
    "product_revision",
    "dataset_revision_ids",
    "parameters",
    "metrics",
    "validity_envelope",
    "fit_converged",
    "identifiable",
    "parameters_at_bounds",
    "meets_validation_limit",
    "approval_eligible",
    "warnings",
    "observation_fits"
  ],
  "title": "CalibrationResult",
  "type": "object"
}
